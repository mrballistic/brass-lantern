# Copy to .env (gitignored) for local dev, or into the server process's
# environment in production (keep that file readable only by the user that
# runs the server). GEMINI_KEY is the only required var.
#
# The key is read only by this server and sent to Google in a request header.
# It never reaches the browser: do not put it in the repo-root .env, and never
# give it a VITE_ prefix (Vite inlines VITE_* vars into the public bundle).

GEMINI_KEY=                       # from https://aistudio.google.com/apikey

# Optional
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# RATE_LIMIT_PER_MINUTE=30
PORT=3001
NODE_ENV=production
