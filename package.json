{
  "name": "brass-lantern",
  "version": "1.13.0",
  "author": "Todd Greco <mrballistic@gmail.com>",
  "private": true,
  "description": "A small engine for classic parser text adventures, with a CRT terminal and an optional LLM intent parser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrballistic/brass-lantern.git"
  },
  "homepage": "https://mrballistic.github.io/brass-lantern/",
  "keywords": [
    "text-adventure",
    "interactive-fiction",
    "parser",
    "vue",
    "crt"
  ],
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w brass-lantern-site",
    "build": "npm run build -w brass-lantern-site",
    "build:packages": "npm run build -w @brass-lantern/engine && npm run build -w @brass-lantern/server && npm run build -w @brass-lantern/vue",
    "preview": "npm run preview -w brass-lantern-site",
    "type-check": "npm run type-check --workspaces",
    "lint": "eslint .",
    "lint:root": "eslint --ignore-pattern \"packages/**\" --ignore-pattern \"apps/**\" .",
    "test": "npm test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "smoke": "node scripts/consumer-smoke.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "6.2.5",
    "glkote-term": "0.4.4",
    "globals": "^17.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=24"
  }
}
