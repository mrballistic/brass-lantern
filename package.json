{
  "name": "brass-lantern",
  "version": "1.8.0",
  "author": "Todd Greco <mrballistic@gmail.com>",
  "private": true,
  "description": "A small engine for classic parser text adventures, with a CRT terminal and an optional LLM intent parser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrballistic/brass-lantern.git"
  },
  "homepage": "https://mrballistic.github.io/brass-lantern/",
  "keywords": [
    "text-adventure",
    "interactive-fiction",
    "parser",
    "vue",
    "crt"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "ifvms": "1.1.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "6.2.5",
    "glkote-term": "0.4.4",
    "globals": "^17.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=24"
  }
}
