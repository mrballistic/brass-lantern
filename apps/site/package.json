{
  "name": "brass-lantern-site",
  "version": "2.1.1",
  "author": "Todd Greco <mrballistic@gmail.com>",
  "private": true,
  "description": "The Brass Lantern demo site: Snack Attack, Zork I and the Zork story files, on the library packages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
