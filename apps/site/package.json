    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@brass-lantern/engine": "2.1.1",
    "@brass-lantern/vue": "2.1.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=24"
  }
}
