{
  "name": "@brass-lantern/vue",
  "version": "2.0.0",
  "author": "Todd Greco <mrballistic@gmail.com>",
  "description": "Brass Lantern for Vue: the CRT terminal, the game store, themes, and a mountGame helper.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrballistic/brass-lantern.git",
    "directory": "packages/vue"
  },
  "homepage": "https://mrballistic.github.io/brass-lantern/",
  "bugs": "https://github.com/mrballistic/brass-lantern/issues",
  "keywords": [
    "text-adventure",
    "interactive-fiction",
    "vue",
    "crt",
    "terminal"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@brass-lantern/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "@brass-lantern/source": "./src/styles/crt.css",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@brass-lantern/engine": "^2.0.0",
    "ifvms": "^1.1.6"
  },
  "peerDependencies": {
    "pinia": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
