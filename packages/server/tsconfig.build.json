{
  // Tests live in tsconfig.json so type-check and Vitest see them (without
  // that, Vite walks up to the repo-root tsconfig, which needs the frontend's
  // node_modules). The build leaves them out of dist/.
  //
  // dist/ holds the library (lib, express and what they import, with
  // declarations) and this repo's own server process (index, config), which
  // `npm start` runs. package.json's `files` leaves index, config and the
  // source maps out of the published tarball.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true
  },
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/test-setup.ts"]
}
