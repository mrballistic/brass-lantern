{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    // Relative imports name their .ts file; the build rewrites them to .js,
    // so dist/ runs in Node without a bundler.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
